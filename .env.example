APP_NAME="Lock"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lock.test

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Empty means Sentry is inert. Add `sentry_logs` to LOG_STACK and set
# SENTRY_ENABLE_LOGS=true to forward log records as well.
SENTRY_LARAVEL_DSN=
SENTRY_ENABLE_LOGS=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# config/mail.php defaults to smtp for deployments.
MAIL_MAILER=log
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Local setup generates the client secret; deployments provide their own values.
LOCK_CONSOLE_CLIENT_ID=lock-console
LOCK_CONSOLE_CLIENT_SECRET=
LOCK_ADMIN_EMAIL=test@example.com
LOCK_ADMIN_PASSWORD=password
